<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dynamic Notch on WinUI 3 (Windows App SDK). The notch shape, the morph and every motion run in
       the compositor, so animations hold the display's refresh rate (see docs/PORTING-PLAN.md).
       Self-contained (no Windows App SDK runtime install needed). It runs unpackaged for debugging
       (scripts/run-debug.ps1) and as a loose or signed MSIX for package identity (Package/AppxManifest.xml,
       scripts/register-dev.ps1, scripts/make-msix.ps1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RollForward>Major</RollForward>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>DynamicNotch</AssemblyName>
    <RootNamespace>DynamicNotch</RootNamespace>
    <Version>2.10.5</Version>
    <!-- Program.cs owns Main (single-instance check before XAML starts). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <!-- Win2D: builds the path geometry for the squircle corners (the compositor animates it;
         nothing is drawn by Win2D itself). -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <!-- Clock / battery listen to SystemEvents (part of the WPF/WinForms framework, separate for WinUI). -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <!-- Laptop panel brightness (WMI rootwmi): level, change events and set. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Optional official Claude logo (not shipped): drop claude-logo.svg or .png in Assets to use it. -->
    <Content Include="Assets\claude-logo.*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bundled fonts (SIL Open Font Licence): Inter (default) plus Geist, DM Sans, Manrope, Plus Jakarta Sans,
         Outfit and Space Grotesk for the font picker (Settings ▸ General). -->
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\*-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- UI sounds: synthesised by tools/SoundGen (original, royalty-free), embedded so nothing is read from disk. -->
    <EmbeddedResource Include="Assets\Sounds\*.wav" LogicalName="Sounds.%(Filename).wav" />
  </ItemGroup>

</Project>
