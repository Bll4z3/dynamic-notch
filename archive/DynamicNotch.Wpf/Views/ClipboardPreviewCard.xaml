<UserControl x:Class="DynamicNotch.Views.ClipboardPreviewCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:DynamicNotch.Design"
             xmlns:v="clr-namespace:DynamicNotch.Views"
             IsHitTestVisible="False" Focusable="False">
    <!-- Deep black card, 1px ~8% white inner border, global radius, soft shadow. Never takes the mouse
         or focus, so hovering stays on the tile underneath. -->
    <Border x:Name="Card" Background="{x:Static d:Theme.NotchBrush}" BorderBrush="{x:Static d:Theme.HighlightBorderBrush}"
            BorderThickness="1" CornerRadius="{x:Static d:Theme.RadiusSmall}" Padding="{x:Static d:Theme.PreviewPadding}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black" RenderingBias="Performance" />
        </Border.Effect>
        <Grid>
            <!-- Image: the whole picture, Uniform, on a dark backing (sized in code to the image's aspect) -->
            <Border x:Name="ImageFrame" CornerRadius="{x:Static d:Theme.RadiusSmall}" Background="{x:Static d:Theme.TileBrush}" Visibility="Collapsed">
                <Border x:Name="ImageBox" CornerRadius="{x:Static d:Theme.RadiusSmall}">
                    <Border.Background>
                        <ImageBrush x:Name="ImageFill" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Border>
            <!-- Text: readable size, wrapped, capped with an ellipsis -->
            <TextBlock x:Name="Text" Width="{x:Static d:Theme.PreviewTextWidth}" TextWrapping="Wrap" Visibility="Collapsed"
                       FontFamily="{x:Static d:Theme.Font}" FontSize="{x:Static d:Theme.PreviewTextFontSize}"
                       LineHeight="{x:Static d:Theme.PreviewTextLineHeight}" Foreground="{x:Static d:Theme.PrimaryText}" />
            <!-- Link: icon + full URL -->
            <Grid x:Name="LinkPanel" Width="{x:Static d:Theme.PreviewTextWidth}" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <v:VectorIcon Data="{x:Static d:Icons.Link}" Size="{x:Static d:Theme.IconMedium}" VerticalAlignment="Top"
                              Foreground="{x:Static d:Theme.AccentBrush}" Margin="{x:Static d:Theme.GapRightS2}" />
                <TextBlock x:Name="LinkText" Grid.Column="1" TextWrapping="Wrap" FontFamily="{x:Static d:Theme.Font}"
                           FontSize="{x:Static d:Theme.PreviewTextFontSize}" LineHeight="{x:Static d:Theme.PreviewTextLineHeight}"
                           Foreground="{x:Static d:Theme.PrimaryText}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
