<UserControl x:Class="DynamicNotch.Views.MusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:DynamicNotch.Design"
             xmlns:v="clr-namespace:DynamicNotch.Views"
             xmlns:a="clr-namespace:DynamicNotch.Animation">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{x:Static d:Theme.GapS5}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Album art. ArtHost carries the shared-element transform (mini art ⇄ big art). Click to cycle players. -->
        <Grid x:Name="ArtHost" Grid.Column="0" Width="{x:Static d:Theme.AlbumArtSize}" Height="{x:Static d:Theme.AlbumArtSize}"
              VerticalAlignment="Center">
            <Border a:Stagger.Order="1">
                <Border x:Name="ArtCard" CornerRadius="{x:Static d:Theme.Radius}" Background="{x:Static d:Theme.TileBrush}"
                        BorderBrush="{x:Static d:Theme.TileBorderBrush}" BorderThickness="1"
                        Cursor="Hand" a:MotionBehaviors.PressScale="True"
                        MouseLeftButtonUp="ArtCard_Click" ToolTip="{Binding SessionHint}">
                    <Grid>
                        <v:VectorIcon Data="{x:Static d:Icons.Music}" Size="40" Foreground="{x:Static d:Theme.TertiaryText}" />
                        <Border CornerRadius="{x:Static d:Theme.Radius}" Margin="-1"
                                Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- Details column: centred on the same horizontal line as the cover (same row, both VerticalAlignment=Center). -->
        <Grid x:Name="Details" Grid.Column="2" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{x:Static d:Theme.GapS3}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{x:Static d:Theme.GapS1}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title (bold), artist, source app -->
            <StackPanel Grid.Row="0" a:Stagger.Order="2">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Artist}" Margin="{x:Static d:Theme.GapTopS1}" />
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding SessionHint}" Margin="{x:Static d:Theme.GapTopS1}" />
            </StackPanel>

            <!-- Progress: elapsed | bar | remaining (bold, tabular, +2pt) -->
            <Grid Grid.Row="2" a:Stagger.Order="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Static d:Theme.TimeColumn}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{x:Static d:Theme.TimeColumn}" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource MusicTimeText}" Text="{Binding ElapsedText}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                <v:SeekBar x:Name="Seek" Grid.Column="1"
                           Value="{Binding Progress, Mode=OneWay}" IsSeekable="{Binding CanSeek}" />
                <TextBlock Grid.Column="2" Style="{StaticResource MusicTimeText}" Text="{Binding RemainingText}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <!-- Transport: outline prev/next, large filled play/pause -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" a:Stagger.Order="4">
                <Button Style="{StaticResource IconButton}" FontSize="{x:Static d:Theme.IconMedium}"
                        Content="{x:Static d:Icons.Prev}" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" />
                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Margin="{x:Static d:Theme.TransportGap}"
                        Width="{x:Static d:Theme.PlayButtonSize}" Height="{x:Static d:Theme.PlayButtonSize}"
                        FontSize="{x:Static d:Theme.IconHero}" Content="{x:Static d:Icons.Play}"
                        Command="{Binding PlayPauseCommand}" IsEnabled="{Binding HasMedia}" />
                <Button Style="{StaticResource IconButton}" FontSize="{x:Static d:Theme.IconMedium}"
                        Content="{x:Static d:Icons.Next}" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
