<Window x:Class="DynamicNotch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:DynamicNotch.Design"
        xmlns:v="clr-namespace:DynamicNotch.Views"
        xmlns:vm="clr-namespace:DynamicNotch.ViewModels"
        xmlns:a="clr-namespace:DynamicNotch.Animation"
        xmlns:app="clr-namespace:DynamicNotch"
        Title="Dynamic Notch Settings"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True"
        FontFamily="{x:Static d:Theme.Font}" UseLayoutRounding="True"
        SizeToContent="WidthAndHeight">
    <Window.Resources>
        <!-- One template per tab view model: add a tab = add a SettingsTab + a DataTemplate here. -->
        <DataTemplate DataType="{x:Type vm:ApiKeyTabViewModel}">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}" Text="Claude API key" />
                <TextBlock Style="{StaticResource SecondaryText}" Margin="{x:Static d:Theme.GapTopS1}" TextWrapping="Wrap"
                           Text="Paste your API key to turn on Ask Claude." />
                <TextBlock Margin="{x:Static d:Theme.GapTopS1}" FontSize="{x:Static d:Theme.FontBody}">
                    <Hyperlink Command="{Binding OpenKeyPageCommand}" Foreground="{x:Static d:Theme.AccentBrush}" TextDecorations="{x:Null}">
                        <Run Text="{x:Static app:AppConfig.ApiKeyPageLabel}" />
                    </Hyperlink>
                </TextBlock>

                <!-- Key box: masked by default, eye toggles plain text; Paste fills it from the clipboard. -->
                <Grid Margin="{x:Static d:Theme.GapTopS3}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <PasswordBox x:Name="KeyBox" Style="{StaticResource KeyInput}" Loaded="KeyBox_Loaded" />
                        <TextBox x:Name="KeyPlain" Style="{StaticResource AskInput}" FontFamily="{x:Static d:Theme.MonoFont}"
                                 AcceptsReturn="False" TextWrapping="NoWrap" Height="{x:Static d:Theme.SettingsFieldHeight}"
                                 Tag="sk-ant-…" Visibility="Collapsed" Loaded="KeyPlain_Loaded" />
                    </Grid>
                    <Button x:Name="EyeButton" Grid.Column="1" Style="{StaticResource SmallIconButton}" Content="{x:Static d:Icons.Eye}"
                            ToolTip="Show / hide" Margin="{x:Static d:Theme.GapLeftS1}" Click="Eye_Click" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryPillButton}" Tag="{x:Static d:Icons.Paste}" Content="Paste"
                            Margin="{x:Static d:Theme.GapLeftS1}" Click="Paste_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="{x:Static d:Theme.GapTopS3}">
                    <Button Style="{StaticResource PillButton}" Tag="{x:Static d:Icons.Check}" Content="Save" Click="Save_Click" />
                    <Button Style="{StaticResource SecondaryPillButton}" Tag="{x:Static d:Icons.Delete}" Content="Remove key"
                            Margin="{x:Static d:Theme.GapLeftS2}" Command="{Binding RemoveCommand}" />
                    <Button Style="{StaticResource SecondaryPillButton}" Tag="{x:Static d:Icons.Sparkle}" Content="Test connection"
                            Margin="{x:Static d:Theme.GapLeftS2}" Click="Test_Click" />
                </StackPanel>

                <!-- Status: masked key only; spring check after Save; test result in green / red. -->
                <StackPanel Orientation="Horizontal" Margin="{x:Static d:Theme.GapTopS4}">
                    <v:VectorIcon x:Name="SavedCheck" Data="{x:Static d:Icons.Check}" Size="{x:Static d:Theme.IconSmall}"
                                  Foreground="{x:Static d:Theme.SuccessBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5"
                                  Margin="{x:Static d:Theme.GapRightS2}" Loaded="SavedCheck_Loaded" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="TestLine" Margin="{x:Static d:Theme.GapTopS1}" Text="{Binding TestText}" TextWrapping="Wrap"
                           FontFamily="{x:Static d:Theme.Font}" FontSize="{x:Static d:Theme.FontBody}" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{x:Static d:Theme.SecondaryText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestResult}" Value="Works">
                                    <Setter Property="Foreground" Value="{x:Static d:Theme.SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestResult}" Value="Rejected">
                                    <Setter Property="Foreground" Value="{x:Static d:Theme.DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <!-- Pages tab: one row per notch page, switch on the right. -->
        <DataTemplate DataType="{x:Type vm:PagesTabViewModel}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource TitleText}" Text="Pages" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="{x:Static d:Theme.GapTopS1}" TextWrapping="Wrap"
                               Text="Choose which pages the notch shows." />
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="{x:Static d:Theme.GapTopS3}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{x:Static d:Theme.CardBrush}" BorderBrush="{x:Static d:Theme.CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="{x:Static d:Theme.Radius}" Padding="{x:Static d:Theme.PageRowPadding}"
                                        Margin="{x:Static d:Theme.PageRowMargin}" MinHeight="{x:Static d:Theme.PageRowHeight}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Icon in a rounded tile -->
                                        <Border Width="{x:Static d:Theme.PageIconTile}" Height="{x:Static d:Theme.PageIconTile}" VerticalAlignment="Center"
                                                CornerRadius="{x:Static d:Theme.Radius}" Background="{x:Static d:Theme.TileBrush}"
                                                BorderBrush="{x:Static d:Theme.TileBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <v:VectorIcon x:Name="RowIcon" Data="{Binding Icon}" Size="{x:Static d:Theme.IconMedium}"
                                                              Foreground="{x:Static d:Theme.PrimaryText}" />
                                                <v:ClaudeLogo x:Name="RowLogo" Size="{x:Static d:Theme.IconMedium}" HorizontalAlignment="Center"
                                                              Foreground="{x:Static d:Theme.PrimaryText}" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{x:Static d:Theme.GapLeftS3}">
                                            <TextBlock Style="{StaticResource BaseText}" Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Description}"
                                                       Foreground="{x:Static d:Theme.SecondaryText}" Margin="{x:Static d:Theme.GapTopS1}" />
                                        </StackPanel>
                                        <v:PillSwitch Grid.Column="2" VerticalAlignment="Center" Margin="{x:Static d:Theme.GapLeftS3}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" ShakeTrigger="{Binding ShakeToken}"
                                                      ToolTip="{Binding Name}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding UseClaudeLogo}" Value="True">
                                        <Setter TargetName="RowIcon" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="RowLogo" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Message}" FontFamily="{x:Static d:Theme.Font}" FontSize="{x:Static d:Theme.FontBody}"
                               FontWeight="SemiBold" Foreground="{x:Static d:Theme.DangerBrush}" Margin="{x:Static d:Theme.GapTopS1}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource CaptionText}" Text="Changes apply instantly." />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Room around the card for its shadow. -->
    <Grid Margin="{x:Static d:Theme.SettingsShadowMargin}">
        <Border x:Name="Card" Width="{x:Static d:Theme.SettingsWidth}" Height="{x:Static d:Theme.SettingsHeight}"
                Background="{x:Static d:Theme.NotchBrush}" BorderBrush="{x:Static d:Theme.HighlightBorderBrush}" BorderThickness="1"
                CornerRadius="{x:Static d:Theme.Radius}" RenderTransformOrigin="0.5,0.5" Opacity="0"
                MouseLeftButtonDown="Card_MouseDown">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.6" Color="Black" RenderingBias="Performance" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Static d:Theme.SettingsTabColumn}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tab list (data-driven) with a highlight pill that springs between tabs -->
                <Grid Margin="{x:Static d:Theme.SettingsTabPadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="{x:Static d:Theme.CardHeaderMargin}">
                        <v:VectorIcon Data="{x:Static d:Icons.Settings}" Size="{x:Static d:Theme.IconSmall}" Foreground="{x:Static d:Theme.SecondaryText}" />
                        <TextBlock Style="{StaticResource SectionText}" Text="Settings" Margin="{x:Static d:Theme.GapLeftS2}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Border x:Name="TabHighlight" Height="{x:Static d:Theme.SettingsTabHeight}" VerticalAlignment="Top"
                                CornerRadius="{x:Static d:Theme.Radius}" Background="{x:Static d:Theme.CardHoverBrush}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TabHighlightMove" />
                            </Border.RenderTransform>
                        </Border>
                        <ItemsControl x:Name="TabList" ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="{x:Static d:Theme.SettingsTabHeight}" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonUp="Tab_Click" a:MotionBehaviors.PressScale="True">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{x:Static d:Theme.GapLeftS3}">
                                            <v:VectorIcon Data="{Binding Icon}" Size="{x:Static d:Theme.IconSmall}" Foreground="{x:Static d:Theme.PrimaryText}" />
                                            <TextBlock Style="{StaticResource BaseText}" Text="{Binding Title}" Margin="{x:Static d:Theme.GapLeftS2}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>

                <!-- Divider + content -->
                <Border Grid.Column="1" BorderBrush="{x:Static d:Theme.CardBorderBrush}" BorderThickness="1,0,0,0">
                    <Grid Margin="{x:Static d:Theme.SettingsPadding}">
                        <ContentControl x:Name="TabContent" Content="{Binding SelectedTab.Content}" Focusable="False" />
                        <Button Style="{StaticResource SmallIconButton}" Content="{x:Static d:Icons.Close}" ToolTip="Close (Esc)"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
