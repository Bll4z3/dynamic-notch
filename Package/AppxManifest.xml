<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest. Package identity is what unlocks UserNotificationListener (app notifications).
     __ARCH__ is replaced by the packaging scripts (x64 / arm64). The app is the WinUI 3 build
     (src/DynamicNotch.WinUI, self-contained Windows App SDK). Bump Version for every install that
     must update an existing registration in place (an update keeps the package's data). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="DynamicNotch"
            Publisher="CN=DynamicNotch Dev"
            Version="2.1.0.1"
            ProcessorArchitecture="__ARCH__" />

  <Properties>
    <DisplayName>Dynamic Notch</DisplayName>
    <PublisherDisplayName>Dynamic Notch</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A notch overlay with a music player, clipboard, shelf, Ask Claude and notification pills.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="DynamicNotch.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Dynamic Notch"
                          Description="Notch overlay"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows" (toggled from the tray menu) -->
        <desktop:Extension Category="windows.startupTask" Executable="DynamicNotch.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DynamicNotchStartup" Enabled="false" DisplayName="Dynamic Notch" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap3:Capability Name="userNotificationListener" />
    <DeviceCapability Name="bluetooth" />
    <!-- Wi-Fi popup: scan / connect through WiFiAdapter; location lets Windows reveal network names. -->
    <DeviceCapability Name="wiFiControl" />
    <DeviceCapability Name="location" />
    <DeviceCapability Name="radios" />
  </Capabilities>
</Package>
