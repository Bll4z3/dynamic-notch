<Project Sdk="Microsoft.NET.Sdk">
  <!-- Synthesises the notch's UI sounds (all original, generated from maths: no samples, no third-party audio).
       Run: dotnet run (project tools/SoundGen). Writes src/DynamicNotch.WinUI/Assets/Sounds/*.wav -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
